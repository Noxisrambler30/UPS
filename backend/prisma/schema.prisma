generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum RequestStatus {
  PENDING
  QUOTED
  REVISION_REQUESTED
  APPROVED
  BILLED
}

model User {
  id        Int       @id @default(autoincrement())
  name      String?
  phone     String?   @unique
  email     String?   @unique
  password  String?
  role      Role      @default(CUSTOMER)
  requests  Request[]
  createdAt DateTime  @default(now())
}

model Request {
  id              Int              @id @default(autoincrement())
  uniqueCode      String           @unique
  power           String
  backup          String
  phase           String
  status          RequestStatus    @default(PENDING)
  customer        User             @relation(fields: [customerId], references: [id])
  customerId      Int
  quote           Quote?
  bill            Bill?
  serviceRequests ServiceRequest[]
  createdAt       DateTime         @default(now())
}

model Quote {
  id          Int             @id @default(autoincrement())
  request     Request         @relation(fields: [requestId], references: [id])
  requestId   Int             @unique
  amount      Float
  pdfPublicId String
  pdfUrl      String
  lineItems   QuoteLineItem[]
  sentAt      DateTime        @default(now())
  updatedAt   DateTime         @updatedAt
}

model QuoteLineItem {
  id          Int    @id @default(autoincrement())
  quote       Quote  @relation(fields: [quoteId], references: [id])
  quoteId     Int
  description String
  qty         Int
  unitPrice   Float
  gstRate     Float  @default(18)   // total rate, e.g. 18%
  sgstAmount  Float                  // half of gstRate applied
  cgstAmount  Float                  // half of gstRate applied
  lineTotal   Float                  // qty * unitPrice, before tax
  grandTotal  Float                  // lineTotal + sgstAmount + cgstAmount
}

model Bill {
  id         Int      @id @default(autoincrement())
  request    Request  @relation(fields: [requestId], references: [id])
  requestId  Int      @unique
  amount     Float
  approvedAt DateTime @default(now())
}

model ServiceRequest {
  id        Int           @id @default(autoincrement())
  request   Request       @relation(fields: [requestId], references: [id])
  requestId Int
  issue     String
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

model Otp {
  id         Int      @id @default(autoincrement())
  identifier String
  code       String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
}